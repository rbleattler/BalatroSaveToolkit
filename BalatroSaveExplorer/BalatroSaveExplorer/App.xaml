<Application x:Class="BalatroSaveExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BalatroSaveExplorer"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:BalatroSaveExplorer.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Region: Themes -->
                <!-- Theme resources will be loaded by ThemeManager -->
                <ResourceDictionary Source="/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
                <!-- EndRegion: Themes -->

                <!-- Region: Styles -->
                <ResourceDictionary Source="/Styles/MenuStyles.xaml"/>
                <ResourceDictionary Source="/Styles/BorderStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ComboBoxItemStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ContentPresenterStyles.xaml"/>
                <ResourceDictionary Source="/Styles/DockPanelStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ExpanderStyles.xaml"/>
                <ResourceDictionary Source="/Styles/GridStyles.xaml"/>
                <ResourceDictionary Source="/Styles/GroupBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/LabelStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ListBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ListBoxItemStyles.xaml"/>
                <ResourceDictionary Source="/Styles/MenuItemStyles.xaml"/>
                <ResourceDictionary Source="/Styles/RadioButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ScrollViewerStyles.xaml"/>
                <ResourceDictionary Source="/Styles/SeparatorStyles.xaml"/>
                <ResourceDictionary Source="/Styles/StackPanelStyles.xaml"/>
                <ResourceDictionary Source="/Styles/StatusBarStyles.xaml"/>
                <ResourceDictionary Source="/Styles/TabControlStyles.xaml"/>
                <ResourceDictionary Source="/Styles/TabItemStyles.xaml"/>
                <!-- <ResourceDictionary Source="/Styles/TextBlockStyles.xaml"/> -->
                <ResourceDictionary Source="/Styles/TextBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/TreeViewStyles.xaml"/>
                <ResourceDictionary Source="/Styles/TreeViewItemStyles.xaml"/>
                <ResourceDictionary Source="/Styles/UserControlStyles.xaml"/>
                <ResourceDictionary Source="/Styles/WindowStyles.xaml"/>
                <!-- EndRegion: Styles -->
                <!-- Region: Templates -->
                <ResourceDictionary Source="/Templates/FilePathSelectorTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/FilePathSelectorWithLoadTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/InfoDisplayTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/ButtonGroupTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/ToolbarButtonGroupTemplate.xaml"/>

                <!-- TabControl and TabItem Templates -->
                <ResourceDictionary Source="/Templates/BaseTabControlTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/BaseTabItemTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/TreeViewTabItemTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/InfoTabItemTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/SettingsTabItemTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/FileInfoTabItemTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/SaveViewTabItemTemplate.xaml"/>
                <!-- EndRegion: Templates -->

            </ResourceDictionary.MergedDictionaries>
            <conv:PercentageConverter x:Key="PercentConverter"/>

            <sys:Double x:Key="AppMinWidth">400</sys:Double>
            <!-- implicit style that gives *every* Control a MinWidth = 85% of its Window -->
            <Style TargetType="Control">
                <Setter Property="MinWidth"
                        Value="{Binding
                          Path=ActualWidth,
                          RelativeSource={RelativeSource AncestorType=Window},
                          Converter={StaticResource PercentConverter},
                          ConverterParameter=0.85}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>