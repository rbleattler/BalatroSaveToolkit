<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->

    <!-- Window and Background Colors -->
    <SolidColorBrush
        x:Key="WindowBackgroundBrush"
        Color="#1E1E1E"/>
    <SolidColorBrush
        x:Key="ControlBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="PanelBackgroundBrush"
        Color="#252526"/>
    <SolidColorBrush
        x:Key="InputBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="AlternateBackgroundBrush"
        Color="#2A2A2A"/>
    <SolidColorBrush
        x:Key="LogPanelBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="LogPanelHeaderBrush"
        Color="#383838"/>

    <!-- Text Colors -->
    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="#FFFFFF"/>
    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="#CCCCCC"/>
    <SolidColorBrush
        x:Key="DisabledTextBrush"
        Color="#808080"/>
    <SolidColorBrush
        x:Key="PlaceholderTextBrush"
        Color="#999999"/>
    <SolidColorBrush
        x:Key="InvertedTextBrush"
        Color="#FFFFFF"/>
    <SolidColorBrush
        x:Key="AccentTextBrush"
        Color="#569CD6"/>
    <SolidColorBrush
        x:Key="SuccessTextBrush"
        Color="#6CC36D"/>
    <SolidColorBrush
        x:Key="WarningTextBrush"
        Color="#F0AD4E"/>
    <SolidColorBrush
        x:Key="ErrorTextBrush"
        Color="#F44747"/>
    <SolidColorBrush
        x:Key="InfoTextBrush"
        Color="#75BEFF"/>

    <!-- Border Colors -->
    <SolidColorBrush
        x:Key="BorderBrush"
        Color="#464647"/>
    <SolidColorBrush
        x:Key="FocusBorderBrush"
        Color="#007ACC"/>
    <SolidColorBrush
        x:Key="HoverBorderBrush"
        Color="#5A5A5C"/>
    <SolidColorBrush
        x:Key="GroupBoxBorderBrush"
        Color="#3F3F46"/>

    <!-- Button Colors -->
    <SolidColorBrush
        x:Key="ButtonBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="ButtonHoverBrush"
        Color="#4C4C4C"/>
    <SolidColorBrush
        x:Key="ButtonPressedBrush"
        Color="#5C5C5C"/>
    <SolidColorBrush
        x:Key="ButtonDisabledBrush"
        Color="#2A2A2A"/>

    <!-- Status Bar Colors -->
    <SolidColorBrush
        x:Key="StatusBarBackgroundBrush"
        Color="#007ACC"/>
    <SolidColorBrush
        x:Key="StatusBarTextBrush"
        Color="#FFFFFF"/>

    <!-- Tab Control Colors -->
    <SolidColorBrush
        x:Key="TabBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="TabSelectedBrush"
        Color="#464647"/>
    <!-- Color="#1E1E1E"/> -->
    <SolidColorBrush
        x:Key="TabHoverBrush"
        Color="#383838"/>

    <!-- TreeView Colors -->
    <SolidColorBrush
        x:Key="TreeViewBackgroundBrush"
        Color="#1E1E1E"/>
    <SolidColorBrush
        x:Key="TreeViewSelectedBrush"
        Color="#094771"/>
    <SolidColorBrush
        x:Key="TreeViewHoverBrush"
        Color="#2A2A2A"/>

    <!-- TextBox Colors -->
    <SolidColorBrush
        x:Key="TextBoxBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="TextBoxBorderBrush"
        Color="#5A5A5C"/>
    <SolidColorBrush
        x:Key="TextBoxFocusedBackgroundBrush"
        Color="#404040"/>
    <SolidColorBrush
        x:Key="ReadOnlyTextBoxBackgroundBrush"
        Color="#333333"/>

    <!-- ComboBox Colors -->
    <SolidColorBrush
        x:Key="ComboBoxBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="ComboBoxBorderBrush"
        Color="#5A5A5C"/>
    <SolidColorBrush
        x:Key="ComboBoxDropDownBrush"
        Color="#2D2D30"/>

    <!-- CheckBox Colors -->
    <SolidColorBrush
        x:Key="CheckBoxBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="CheckBoxBorderBrush"
        Color="#5A5A5C"/>
    <SolidColorBrush
        x:Key="CheckBoxForegroundBrush"
        Color="#FFFFFF"/>
    <SolidColorBrush
        x:Key="CheckBoxCheckMarkBrush"
        Color="#FFFFFF"/>
    <SolidColorBrush
        x:Key="CheckBoxCheckedBackgroundBrush"
        Color="#007ACC"/>
    <SolidColorBrush
        x:Key="CheckBoxHoverBrush"
        Color="#505050"/>
    <SolidColorBrush
        x:Key="CheckBoxPressedBrush"
        Color="#606060"/>
    <SolidColorBrush
        x:Key="CheckBoxDisabledBrush"
        Color="#505050"/>
    <SolidColorBrush
        x:Key="CheckBoxDisabledForegroundBrush"
        Color="#808080"/>

    <!-- GroupBox Colors -->
    <SolidColorBrush
        x:Key="GroupBoxHeaderBrush"
        Color="#E0E0E0"/>
    <SolidColorBrush
        x:Key="GroupBoxBackgroundBrush"
        Color="#252526"/>

    <!-- ListBox Colors -->
    <SolidColorBrush
        x:Key="ListBoxBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="ListBoxSelectedBrush"
        Color="#094771"/>
    <SolidColorBrush
        x:Key="ListBoxHoverBrush"
        Color="#383838"/>

    <!-- Menu Colors -->
    <SolidColorBrush
        x:Key="MenuBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="MenuHoverBrush"
        Color="#383838"/>
    <SolidColorBrush
        x:Key="MenuSeparatorBrush"
        Color="#464647"/>

    <!-- ScrollBar Colors -->
    <SolidColorBrush
        x:Key="ScrollBarBackgroundBrush"
        Color="#1E1E1E"/>
    <SolidColorBrush
        x:Key="ScrollBarThumbBrush"
        Color="#555555"/>
    <SolidColorBrush
        x:Key="ScrollBarThumbHoverBrush"
        Color="#666666"/>

    <!-- Selection Colors -->
    <SolidColorBrush
        x:Key="SelectionBackgroundBrush"
        Color="#094771"/>
    <SolidColorBrush
        x:Key="SelectionTextBrush"
        Color="#FFFFFF"/>

    <!-- Additional Colors -->
    <SolidColorBrush
        x:Key="HeaderBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="SeparatorBrush"
        Color="#464647"/>
    <SolidColorBrush
        x:Key="ToggleButtonBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="ToggleButtonSelectedBrush"
        Color="#007ACC"/>
    <SolidColorBrush
        x:Key="ToggleButtonHoverBrush"
        Color="#4C4C4C"/>
    <SolidColorBrush
        x:Key="ToolTipBackgroundBrush"
        Color="#252526"/>
    <SolidColorBrush
        x:Key="ToolTipBorderBrush"
        Color="#5A5A5C"/>
    <SolidColorBrush
        x:Key="ToolTipTextBrush"
        Color="#FFFFFF"/>
    <SolidColorBrush
        x:Key="DataGridBackgroundBrush"
        Color="#1E1E1E"/>
    <SolidColorBrush
        x:Key="DataGridHeaderBackgroundBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="DataGridHeaderBorderBrush"
        Color="#464647"/>
    <SolidColorBrush
        x:Key="DataGridSelectionBackgroundBrush"
        Color="#094771"/>
    <SolidColorBrush
        x:Key="DataGridCellBorderBrush"
        Color="#333333"/>
    <SolidColorBrush
        x:Key="DataGridAlternatingRowBrush"
        Color="#252526"/>
    <SolidColorBrush
        x:Key="ExpanderHeaderBrush"
        Color="#2D2D30"/>
    <SolidColorBrush
        x:Key="ExpanderBackgroundBrush"
        Color="#252526"/>
    <SolidColorBrush
        x:Key="ExpanderBorderBrush"
        Color="#464647"/>
    <SolidColorBrush
        x:Key="RadioButtonBackgroundBrush"
        Color="#3C3C3C"/>
    <SolidColorBrush
        x:Key="RadioButtonBorderBrush"
        Color="#5A5A5C"/>
    <SolidColorBrush
        x:Key="RadioButtonSelectedBrush"
        Color="#007ACC"/>
    <SolidColorBrush
        x:Key="RadioButtonMarkBrush"
        Color="#FFFFFF"/>

</ResourceDictionary>
