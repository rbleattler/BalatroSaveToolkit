<Window x:Class="BalatroSaveExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalatroSaveExplorer"
        xmlns:controls="clr-namespace:BalatroSaveExplorer.Controls"
        xmlns:tabs="clr-namespace:BalatroSaveExplorer.Controls.Tabs"
        mc:Ignorable="d"
        Title="Balatro JKR File Viewer"
        Height="800"
        Width="600"
        MinWidth="{DynamicResource AppMinWidth}">
    <DockPanel>
        <!-- Top toolbar -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="10"
                    Height="40">
            <Button x:Name="LoadFileButton"
                    Content="Load JKR File"
                    MinWidth="120"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                               Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                    Height="30"
                    Click="LoadFileButton_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="SaveAsLuaButton"
                    Content="Save as Lua"
                    MinWidth="120"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                               Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                    Height="30"
                    Click="SaveAsLuaButton_Click"
                    Margin="0,0,10,0"
                    IsEnabled="False"/>
        </StackPanel>
        <!-- Bottom status bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Height="25"
                   Width="Auto">
            <StatusBarItem Width="Auto"
                           HorizontalAlignment="Left">
                <Label x:Name="StatusLabel"
                       Content="Ready"
                       Margin="0"
                       Padding="5,2"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"
                           Width="Auto">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="WatchingIndicator"
                             Width="8"
                             Height="8"
                             Fill="Gray"
                             Margin="0,0,5,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                    <Label x:Name="LastUpdateLabel"
                           Content=""
                           FontSize="10"
                           Margin="0"
                           Padding="2"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content area with tabs -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="LogPanelRow"
                               Height="0"/>
            </Grid.RowDefinitions>

            <!-- Main TabControl -->
            <TabControl x:Name="MainTabControl"
                        Grid.Row="0"
                        Margin="10,0,10,10">
                <!-- Tree View Tab -->
                <TabItem Header="Tree View"
                         x:Name="TreeViewTab">
                    <tabs:TreeViewTab x:Name="TreeViewTabControl"/>
                </TabItem>
                <!-- Info Tab -->
                <TabItem Header="Info"
                         x:Name="InfoTab">
                    <tabs:InfoTab x:Name="InfoTabControl"/>
                </TabItem>
                <!-- Settings Tab -->
                <TabItem Header="Settings"
                         x:Name="SettingsTab">
                    <tabs:SettingsTab x:Name="SettingsTabControl"/>
                </TabItem>
                <!-- File Info Tab -->
                <TabItem Header="File Info"
                         x:Name="FileInfoTab">
                    <tabs:FileInfoTab x:Name="FileInfoTabControl"/>
                </TabItem>
                <TabItem Header="Saves"
                         x:Name="SaveViewTab">
                    <tabs:SaveTab x:Name="SaveTabControl"/>
                </TabItem>
            </TabControl>
            <!-- External log panel (initially hidden) -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    Background="{DynamicResource LogPanelBackgroundBrush}"
                    Margin="10,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Height="25"
                                Background="{DynamicResource LogPanelHeaderBrush}"
                                Margin="0">
                        <Label Content="Debug/Logs"
                               Foreground="{DynamicResource InvertedTextBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                        <Button x:Name="ClearLogsButton"
                                Content="Clear"
                                Width="50"
                                Height="20"
                                Margin="10,0"
                                Click="ClearLogsButton_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 VerticalAlignment="Stretch"
                                 AcceptsReturn="True"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>