<Window x:Class="BalatroSaveExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalatroSaveExplorer"
        xmlns:controls="clr-namespace:BalatroSaveExplorer.Controls"
        xmlns:tabs="clr-namespace:BalatroSaveExplorer.Controls.Tabs"
        mc:Ignorable="d"
        Title="Balatro JKR File Viewer"
        Height="800"
        Width="600"
        MinWidth="400"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <DockPanel>
        <!-- Main content area with tabs -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="LogPanelRow"
                               Height="0"/>
                <!-- StatusBarRow-->
                <RowDefinition x:Name="StatusBarRow"
                               Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main TabControl -->
            <TabControl x:Name="MainTabControl"
                        Grid.Row="0"
                        Margin="10,0,10,10">
                <!-- Tree View Tab -->
                <TabItem Header="Tree View"
                         x:Name="TreeViewTab">
                    <tabs:TreeViewTab x:Name="TreeViewTabControl"/>
                </TabItem>

                <!-- Save Management Tab -->
                <TabItem Header="Saves"
                         x:Name="SaveViewTab">
                    <tabs:SaveTab x:Name="SaveTabControl"/>
                </TabItem>

                <!-- Info Tab -->
                <TabItem Header="Info"
                         x:Name="InfoTab">
                    <tabs:InfoTab x:Name="InfoTabControl"/>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem Header="Settings"
                         x:Name="SettingsTab">
                    <tabs:SettingsTab x:Name="SettingsTabControl"/>
                </TabItem>

                <!-- File Info Tab -->
                <TabItem Header="File Info"
                         x:Name="FileInfoTab">
                    <tabs:FileInfoTab x:Name="FileInfoTabControl"/>
                </TabItem>

            </TabControl>
            <!-- External log panel (initially hidden) -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    Background="{DynamicResource LogPanelBackgroundBrush}"
                    Margin="10,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Height="25"
                                Background="{DynamicResource LogPanelHeaderBrush}"
                                Margin="0">
                        <Label Content="Debug/Logs"
                               Foreground="{DynamicResource InvertedTextBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                        <Button x:Name="ClearLogsButton"
                                Content="Clear"
                                Width="50"
                                Height="20"
                                Margin="10,0"
                                Click="ClearLogsButton_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 VerticalAlignment="Stretch"
                                 AcceptsReturn="True"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="0,0,10,10">
                <controls:StatusBarControl VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

    </DockPanel>
</Window>