<UserControl x:Class="BalatroSaveExplorer.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BalatroSaveExplorer.Controls"
             xmlns:services="clr-namespace:BalatroSaveExplorer.Services"
             Height="28">
    <UserControl.DataContext>
        <Binding Source="{x:Static services:StatusBarService.Instance}"/>
    </UserControl.DataContext>
    <Border x:Name="StatusBarBorder"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource StatusBarBorderBrush}"
            BorderThickness="0"
            Padding="0"
            SnapsToDevicePixels="True"
            Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <!-- App Readiness -->
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="8,0,4,0"
                       FontWeight="Bold"
                       Foreground="{Binding Path=IsError, Converter={StaticResource ErrorForegroundConverter}}">
                <TextBlock.Text>
                    <Binding Path="Readiness"/>
                </TextBlock.Text>
            </TextBlock>
            <!-- Activity -->
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="4,0,4,0"
                       TextTrimming="CharacterEllipsis"
                       Cursor="Hand"
                       Foreground="{Binding Path=IsError, Converter={StaticResource ErrorForegroundConverter}}"
                       ToolTip="Click to view in debug panel"
                       MouseLeftButtonUp="Activity_MouseLeftButtonUp">
                <TextBlock.Text>
                    <Binding Path="ActivityMessage"/>
                </TextBlock.Text>
            </TextBlock>
            <!-- Balatro State -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="4,0,4,0">
                <Ellipse Width="16"
                         Height="16"
                         Margin="0,0,4,0">
                    <Ellipse.Fill>
                        <MultiBinding Converter="{StaticResource BalatroStateToBrushConverter}">
                            <Binding Path="Balatro"/>
                        </MultiBinding>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusBarTextBrush}">
                    <TextBlock.Text>
                        <Binding Path="Balatro"
                                 StringFormat='Balatro Status : {0}'/>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
            <!-- Clear Messages Button -->
            <Button Grid.Column="3"
                    Width="24"
                    Height="24"
                    Margin="4,0,4,0"
                    ToolTip="Clear all messages"
                    Click="ClearButton_Click"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="0"
                    Background="Transparent">
                <TextBlock FontSize="12">✅</TextBlock>
            </Button>
        </Grid>
    </Border>
</UserControl>
