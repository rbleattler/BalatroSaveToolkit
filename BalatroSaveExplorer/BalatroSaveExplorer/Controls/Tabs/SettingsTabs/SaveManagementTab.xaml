<UserControl x:Class="BalatroSaveExplorer.Controls.Tabs.SettingsTabs.SaveManagementTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Save Management Information -->
            <GroupBox Header="Save Management"
                      Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="Save Management Features"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock TextWrapping="Wrap"
                               Margin="0,0,0,10">
                        <Run Text="Save management settings have been moved to better organize the interface:"/>
                    </TextBlock>

                    <StackPanel Margin="20,0,0,15">
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="•"
                                    FontWeight="Bold"/>
                            <Run Text="Auto-save settings"/>
                            <Run Text=" - Configure automatic backup intervals in the "/>
                            <Run Text="General"
                                    FontWeight="Bold"/>
                            <Run Text=" tab"/>
                        </TextBlock>

                        <TextBlock Margin="0,5,0,0">
                            <Run Text="•"
                                    FontWeight="Bold"/>
                            <Run Text="Manual save management"/>
                            <Run Text=" - Create, load, and manage backups in the main "/>
                            <Run Text="Saves"
                                    FontWeight="Bold"/>
                            <Run Text=" tab"/>
                        </TextBlock>

                        <TextBlock Margin="0,5,0,0">
                            <Run Text="•"
                                    FontWeight="Bold"/>
                            <Run Text="Backup directory settings"/>
                            <Run Text=" - Configure backup location in the "/>
                            <Run Text="General"
                                    FontWeight="Bold"/>
                            <Run Text=" tab"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Quick Access -->
            <GroupBox Header="Quick Access"
                      Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="For your convenience:"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock TextWrapping="Wrap"
                               Margin="0,0,0,10">
                        <Run Text="Visit the "/>
                        <Run Text="General"
                                FontWeight="Bold"/>
                        <Run Text=" tab to configure automatic backup settings, including backup frequency and retention policies."/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap"
                               Margin="0,0,0,10">
                        <Run Text="Visit the main "/>
                        <Run Text="Saves"
                                FontWeight="Bold"/>
                        <Run Text=" tab to manually create backups, restore saves, and manage your backup collection."/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- Current Status -->
            <GroupBox Header="Current Status"
                      Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,5">
                        <TextBlock Text="Profile: "
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentProfileTextBlock"
                                   Text="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,5">
                        <TextBlock Text="Save File: "
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentSaveFileTextBlock"
                                   Text=""
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Last Modified: "
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LastModifiedTextBlock"
                                   Text=""/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
