<UserControl x:Class="BalatroSaveExplorer.Controls.Tabs.SettingsTabs.ProfileManagerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <GroupBox Header="Balatro Save Root Configuration"
                      Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <Label Content="Balatro Save Root Directory:"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"
                                    MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BalatroSaveRootTextBox"
                                 Grid.Column="0"
                                 VerticalAlignment="Center"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="BalatroSaveRootTextBox_TextChanged"/>
                        <Button x:Name="BrowseBalatroSaveRootButton"
                                Grid.Column="1"
                                Content="Browse..."
                                MinWidth="80"
                                Height="25"
                                Click="BrowseBalatroSaveRootButton_Click"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,5,0,0">
                        Set the root directory where Balatro saves are stored. Once configured,
                        derived file paths will be displayed in the Info tab for easy access.
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
