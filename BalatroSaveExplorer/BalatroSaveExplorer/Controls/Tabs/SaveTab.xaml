<UserControl x:Class="BalatroSaveExplorer.Controls.Tabs.SaveTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BalatroSaveExplorer.Converters">
    <UserControl.Resources>
        <converters:PercentageConverter x:Key="PercentConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Current Profile Info -->
        <GroupBox Grid.Row="0"
                  Header="Current Profile"
                  Margin="0,0,0,15">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Profile: "
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentProfileTextBlock"
                               Text="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Save File: "
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentSaveFileTextBlock"
                               Text=""
                               TextWrapping="Wrap"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Last Modified: "
                               FontWeight="Bold"/>
                    <TextBlock x:Name="LastModifiedTextBlock"
                               Text=""/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Save Backups List -->
        <GroupBox Grid.Row="1"
                  Header="Save Backups"
                  Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Controls -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Button x:Name="RefreshListButton"
                            Content="Refresh"
                            MinWidth="80"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                       Converter={StaticResource PercentConverter}, ConverterParameter=0.15}"
                            Height="30"
                            Margin="0,0,10,0"
                            Click="RefreshListButton_Click"/>
                    <TextBlock Text="Total: "
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="TotalBackupsTextBlock"
                               Text="0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    <TextBlock Text=" backups"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Saves List with proper styling -->
                <ListView Grid.Row="1"
                          x:Name="SaveBackupsListView"
                          SelectionMode="Single"
                          SelectionChanged="SaveBackupsListView_SelectionChanged"
                          Background="{DynamicResource ControlBackgroundBrush}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource BorderBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Filename"
                                            Width="250"
                                            DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Created"
                                            Width="140"
                                            DisplayMemberBinding="{Binding FormattedDate}"/>
                            <GridViewColumn Header="Size"
                                            Width="100"
                                            DisplayMemberBinding="{Binding FormattedSize}"/>
                            <GridViewColumn Header="Type"
                                            Width="80"
                                            DisplayMemberBinding="{Binding BackupType}"/>
                        </GridView>
                    </ListView.View>
                    <!-- Ensure text contrast -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource InvertedTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- Action Buttons with responsive layout -->
        <GroupBox Grid.Row="2"
                  Header="Actions"
                  Margin="0,0,0,15">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <Button x:Name="SaveButton"
                            Content="Create Backup"
                            MinWidth="120"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                       Converter={StaticResource PercentConverter}, ConverterParameter=0.25}"
                            Height="35"
                            Margin="0,0,10,0"
                            ToolTip="Create a manual backup of the current save"
                            Click="SaveButton_Click"/>
                    <Button x:Name="LoadButton"
                            Content="Load Backup"
                            MinWidth="120"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                       Converter={StaticResource PercentConverter}, ConverterParameter=0.25}"
                            Height="35"
                            Margin="0,0,10,0"
                            ToolTip="Load the selected backup to the current profile"
                            IsEnabled="False"
                            Click="LoadButton_Click"/>
                    <Button x:Name="DeleteButton"
                            Content="Delete"
                            MinWidth="100"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                       Converter={StaticResource PercentConverter}, ConverterParameter=0.2}"
                            Height="35"
                            Margin="0,0,10,0"
                            ToolTip="Delete the selected backup"
                            IsEnabled="False"
                            Click="DeleteButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">
                    <Button x:Name="OpenSavesFolderButton"
                            Content="Open Saves Folder"
                            MinWidth="150"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                       Converter={StaticResource PercentConverter}, ConverterParameter=0.4}"
                            Height="35"
                            Margin="0,0,10,0"
                            ToolTip="Open the backup directory in Windows Explorer"
                            Click="OpenSavesFolderButton_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Debug Options -->
        <GroupBox Grid.Row="3"
                  Header="Debug">
            <StackPanel Margin="10"
                        Orientation="Horizontal">
                <CheckBox x:Name="DebugCheckBox"
                          Content="Enable debug logging for save operations"
                          VerticalAlignment="Center"
                          Checked="DebugCheckBox_CheckedChanged"
                          Unchecked="DebugCheckBox_CheckedChanged"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
