<UserControl x:Class="BalatroSaveExplorer.Controls.Tabs.SaveTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BalatroSaveExplorer.Converters">
    <UserControl.Resources>
        <converters:PercentageConverter x:Key="PercentConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <!-- Reserved area for save overview -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Current Profile Info -->
        <GroupBox Grid.Row="0"
                  Header="Current Profile"
                  Margin="0,0,0,15">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Profile: "
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentProfileTextBlock"
                               Text="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Save File: "
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentSaveFileTextBlock"
                               Text=""
                               TextWrapping="Wrap"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Last Modified: "
                               FontWeight="Bold"/>
                    <TextBlock x:Name="LastModifiedTextBlock"
                               Text=""/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Save Backups List -->
        <GroupBox Grid.Row="1"
                  Header="Save Backups"
                  Margin="0,0,0,15">
            <Grid Margin="10"
                  MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=GroupBox},
                                       Converter={StaticResource PercentConverter}, ConverterParameter=1}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- List Controls: Buttons row -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="RefreshListButton"
                            Content="Refresh"
                            Height="35"
                            Margin="0,0,5,0"
                            Click="RefreshListButton_Click"/>

                    <Button Grid.Column="1"
                            x:Name="SaveButton"
                            Content="Save"
                            Height="35"
                            Margin="5,0,5,0"
                            ToolTip="Create a manual backup of the current save"
                            Click="SaveButton_Click"/>

                    <Button Grid.Column="2"
                            x:Name="LoadButton"
                            Content="Load"
                            Height="35"
                            Margin="5,0,5,0"
                            ToolTip="Load the selected backup to the current profile"
                            IsEnabled="False"
                            Click="LoadButton_Click"/>

                    <Button Grid.Column="3"
                            x:Name="DeleteButton"
                            Content="Delete"
                            Height="35"
                            Margin="5,0,5,0"
                            ToolTip="Delete the selected backup"
                            IsEnabled="False"
                            Click="DeleteButton_Click"/>

                    <Button Grid.Column="4"
                            x:Name="OpenSavesFolderButton"
                            Content="Open 📁"
                            Height="35"
                            Margin="5,0,0,0"
                            ToolTip="Open the backup directory in Windows Explorer"
                            Click="OpenSavesFolderButton_Click"/>
                </Grid>

                <!-- Saves List with proper styling -->
                <ListView Grid.Row="1"
                          x:Name="SaveBackupsListView"
                          SelectionMode="Single"
                          SelectionChanged="SaveBackupsListView_SelectionChanged"
                          Background="{DynamicResource ControlBackgroundBrush}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource BorderBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Filename"
                                            Width="250"
                                            DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Created"
                                            Width="140"
                                            DisplayMemberBinding="{Binding FormattedDate}"/>
                            <GridViewColumn Header="Size"
                                            Width="100"
                                            DisplayMemberBinding="{Binding FormattedSize}"/>
                            <GridViewColumn Header="Type"
                                            Width="80"
                                            DisplayMemberBinding="{Binding BackupType}"/>
                        </GridView>
                    </ListView.View>
                    <!-- Ensure text contrast -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource InvertedTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- Reserved Save Overview Area -->
        <Border Grid.Row="2"
                Margin="0,0,0,15"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="Collapsed">
            <!-- Reserved for save overview -->
        </Border>

        <!-- Debug Options -->
        <GroupBox Grid.Row="3"
                  Header="Debug">
            <StackPanel Margin="10"
                        Orientation="Horizontal">
                <CheckBox x:Name="DebugCheckBox"
                          Content="Enable debug logging for save operations"
                          VerticalAlignment="Center"
                          Checked="DebugCheckBox_CheckedChanged"
                          Unchecked="DebugCheckBox_CheckedChanged"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
