<UserControl x:Class="BalatroSaveExplorer.Controls.Tabs.InfoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BalatroSaveExplorer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Margin="5">
        <StackPanel Margin="10">
            <GroupBox Header="Balatro Integration"
                      Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <Label Content="Balatro Save Root Directory:"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InfoBalatroSaveRootTextBox"
                                 Grid.Column="0"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,5,0"
                                 IsReadOnly="True"/>
                    </Grid>
                    <Separator Margin="0,5,0,10"/>
                    <Label Content="Derived Paths:"
                           FontWeight="Bold"/>
                    <Label Content="Settings File:"
                           Margin="0,5,0,0"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InfoBalatroSettingsFilePathTextBox"
                                 Grid.Column="0"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                 IsReadOnly="True"
                                 Margin="0,0,5,0"/>
                        <Button x:Name="InfoLoadBalatroSettingsButton"
                                Grid.Column="1"
                                Content="Load"
                                MinWidth="50"
                                Height="25"
                                Click="InfoLoadBalatroSettingsButton_Click"/>
                    </Grid>

                    <Label Content="Current Profile:"
                           Margin="0,5,0,0"/>
                    <TextBox x:Name="InfoCurrentProfileNumberTextBox"
                             IsReadOnly="True"
                             Margin="0,0,0,5"/>
                    <Label Content="Profile Settings:"
                           Margin="0,5,0,0"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InfoCurrentProfileSettingsPathTextBox"
                                 Grid.Column="0"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                 IsReadOnly="True"
                                 Margin="0,0,5,0"/>
                        <Button x:Name="InfoLoadProfileSettingsButton"
                                Grid.Column="1"
                                Content="Load"
                                MinWidth="50"
                                Height="25"
                                Click="InfoLoadProfileSettingsButton_Click"/>
                    </Grid>
                    <Label Content="Profile Meta:"
                           Margin="0,5,0,0"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InfoCurrentProfileMetaPathTextBox"
                                 Grid.Column="0"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                 IsReadOnly="True"
                                 Margin="0,0,5,0"/>
                        <Button x:Name="InfoLoadProfileMetaButton"
                                Grid.Column="1"
                                Content="Load"
                                MinWidth="50"
                                Height="25"
                                Click="InfoLoadProfileMetaButton_Click"/>
                    </Grid>
                    <Label Content="Profile Save:"
                           Margin="0,5,0,0"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InfoCurrentProfileSavePathTextBox"
                                 Grid.Column="0"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                 IsReadOnly="True"
                                 Margin="0,0,5,0"/>
                        <Button x:Name="InfoLoadProfileSaveButton"
                                Grid.Column="1"
                                Content="Load"
                                MinWidth="50"
                                Height="25"
                                Click="InfoLoadProfileSaveButton_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>