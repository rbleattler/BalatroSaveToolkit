<UserControl x:Class="BalatroSaveExplorer.Controls.Tabs.TreeViewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BalatroSaveExplorer.Controls"
             xmlns:converters="clr-namespace:BalatroSaveExplorer.Converters"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             Margin="5"
             MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource PercentageConverter}, ConverterParameter=0.90}">
    <GroupBox Header="Tree View"
              Margin="0,0,0,15"
              HorizontalAlignment="Stretch"
              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl},
                                 Converter={StaticResource PercentageConverter}, ConverterParameter=0.90}">

        <controls:SearchableTreeView x:Name="DataTreeView"
                                     Margin="5"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                 Converter={StaticResource PercentageConverter}, ConverterParameter=0.90}"/>
    </GroupBox>
</UserControl>