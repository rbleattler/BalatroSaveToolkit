<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- File Info TabItem template - for tabs displaying file information -->
    <Style x:Key="FileInfoTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource BaseResponsiveTabItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="1,0"
                                Padding="6,0"
                                CornerRadius="3,3,0,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <!-- File info icon -->
                                <TextBlock Text="📄"
                                           FontSize="14"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabSelectedBrush}"
                                    TargetName="Border"/>
                            <Setter Property="Panel.ZIndex"
                                    Value="100"/>
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"
                                    TargetName="ContentSite"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabHoverBrush}"
                                    TargetName="Border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File Info content template for responsive layout -->
    <DataTemplate x:Key="FileInfoTabContentTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Margin="5">
            <StackPanel Margin="10">
                <!-- File Information GroupBox with responsive grid -->
                <GroupBox Header="File Information"
                          Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- File info display fields with responsive sizing -->
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="File Path:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,5"/>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="File Size:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,5"/>

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Content="Last Modified:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,5"/>

                        <Label Grid.Row="3"
                               Grid.Column="0"
                               Content="Compression:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,5"/>

                        <Label Grid.Row="4"
                               Grid.Column="0"
                               Content="Content Type:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,5"/>

                        <Label Grid.Row="5"
                               Grid.Column="0"
                               Content="Entries Count:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,5"/>
                    </Grid>
                </GroupBox>

                <!-- Raw Content section with responsive sizing -->
                <GroupBox Header="Raw Content"
                          Margin="0,0,0,15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Margin="5"
                                  MinHeight="200"
                                  MaxHeight="400">
                        <TextBox IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                            Converter={StaticResource PercentConverter}, ConverterParameter=0.95}"
                                 Background="{DynamicResource TextBoxBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderThickness="0"/>
                    </ScrollViewer>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
