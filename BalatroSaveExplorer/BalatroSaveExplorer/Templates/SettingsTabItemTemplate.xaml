<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings TabItem template - for settings tabs with form controls -->
    <Style x:Key="SettingsTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource BaseResponsiveTabItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="1,0"
                                Padding="6,0"
                                CornerRadius="3,3,0,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <!-- Settings icon -->
                                <TextBlock Text="⚙️"
                                           FontSize="14"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabSelectedBrush}"
                                    TargetName="Border"/>
                            <Setter Property="Panel.ZIndex"
                                    Value="100"/>
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"
                                    TargetName="ContentSite"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabHoverBrush}"
                                    TargetName="Border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings sub-tab styles -->
    <Style x:Key="SettingsSubTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource BaseResponsiveTabItemStyle}">
        <Setter Property="Padding"
                Value="8,4"/>
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="MaxWidth"
                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=TabControl},
                        Converter={StaticResource PercentConverter}, ConverterParameter=0.18}"/>
    </Style>

    <!-- Settings content template for responsive layout -->
    <DataTemplate x:Key="SettingsTabContentTemplate">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Settings sub-tabs with responsive sizing -->
            <TabControl Grid.Row="0"
                        Style="{StaticResource NestedResponsiveTabControlStyle}">
                <!-- Settings sub-tab content would be defined in each specific case -->
            </TabControl>

            <!-- Settings action buttons with responsive layout -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Reset to Defaults"
                        MinWidth="120"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                   Converter={StaticResource PercentConverter}, ConverterParameter=0.4}"
                        Height="30"
                        Margin="0,0,10,0"/>
                <Button Content="Apply"
                        MinWidth="80"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                                   Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                        Height="30"
                        Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Responsive form controls for settings -->
    <Style x:Key="SettingsFormLabelStyle"
           TargetType="Label">
        <Setter Property="FontWeight"
                Value="Medium"/>
        <Setter Property="Margin"
                Value="0,5,0,2"/>
    </Style>

    <Style x:Key="SettingsFormTextBoxStyle"
           TargetType="TextBox">
        <Setter Property="MinWidth"
                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                        Converter={StaticResource PercentConverter}, ConverterParameter=0.75}"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0,0,5,0"/>
    </Style>

    <Style x:Key="SettingsFormComboBoxStyle"
           TargetType="ComboBox">
        <Setter Property="MinWidth"
                Value="200"/>
        <Setter Property="MaxWidth"
                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel},
                        Converter={StaticResource PercentConverter}, ConverterParameter=0.5}"/>
        <Setter Property="HorizontalAlignment"
                Value="Left"/>
        <Setter Property="Margin"
                Value="0,5,0,10"/>
    </Style>

</ResourceDictionary>
