<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Info TabItem template - for tabs with file path selectors and load buttons -->
    <Style x:Key="InfoTabItemStyle"
            TargetType="TabItem"
            BasedOn="{StaticResource BaseResponsiveTabItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="1,0"
                                Padding="6,0"
                                CornerRadius="3,3,0,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <!-- Info icon -->
                                <TextBlock Text="ℹ️"
                                        FontSize="14"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabSelectedBrush}"
                                    TargetName="Border"/>
                            <Setter Property="Panel.ZIndex"
                                    Value="100"/>
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"
                                    TargetName="ContentSite"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabHoverBrush}"
                                    TargetName="Border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Info content template for responsive layout -->
    <DataTemplate x:Key="InfoTabContentTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                Margin="5">
            <StackPanel Margin="10">
                <!-- Responsive GroupBox container -->
                <GroupBox Header="Balatro Integration"
                        Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <!-- File path selector with responsive width -->
                        <Label Content="Balatro Save Root Directory:"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                                Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,5,0"
                                     IsReadOnly="True"/>
                        </Grid>

                        <Separator Margin="0,5,0,10"/>

                        <Label Content="Derived Paths:"
                                FontWeight="Bold"/>

                        <!-- Example file path selectors with responsive layout -->
                        <Label Content="Settings File:"
                                Margin="0,5,0,0"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                                Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                                     IsReadOnly="True"
                                     Margin="0,0,5,0"/>
                            <Button Grid.Column="1"
                                    Content="Load"
                                    MinWidth="50"
                                    Height="25"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
