<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Template for TextBox + Load Button pattern (read-only) -->
    <DataTemplate x:Key="FilePathSelectorWithLoadTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
            <Button Grid.Column="1"
                    Content="Load"
                    MinWidth="50"
                    Height="25"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
