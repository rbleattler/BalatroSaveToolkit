<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:BalatroSaveExplorer.Converters">

    <converters:PercentageConverter x:Key="PercentageConverter"/>

    <!-- TreeView TabItem template - for tabs containing TreeView controls -->
    <Style x:Key="TreeViewTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource BaseResponsiveTabItemStyle}">
        <!-- Specific styling for TreeView tabs -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="1,0"
                                Padding="6,0"
                                CornerRadius="3,3,0,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <!-- TreeView icon -->
                                <TextBlock Text="🌳"
                                           FontSize="14"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabSelectedBrush}"
                                    TargetName="Border"/>
                            <Setter Property="Panel.ZIndex"
                                    Value="100"/>
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"
                                    TargetName="ContentSite"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabHoverBrush}"
                                    TargetName="Border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeView content template for responsive layout -->
    <DataTemplate x:Key="TreeViewTabContentTemplate">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="*"/>
            </Grid.RowDefinitions>
            <TreeView x:Name="DataTreeView"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                 Converter={StaticResource PercentageConverter}, ConverterParameter=0.95}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="2">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ValueDisplay}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
