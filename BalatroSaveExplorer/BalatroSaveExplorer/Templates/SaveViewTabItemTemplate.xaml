<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Save View TabItem template - for save management tabs -->
    <Style x:Key="SaveViewTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource BaseResponsiveTabItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="1,0"
                                Padding="6,0"
                                CornerRadius="3,3,0,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <!-- Save view icon -->
                                <TextBlock Text="💾"
                                           FontSize="14"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabSelectedBrush}"
                                    TargetName="Border"/>
                            <Setter Property="Panel.ZIndex"
                                    Value="100"/>
                            <Setter Property="TextBlock.FontWeight"
                                    Value="Bold"
                                    TargetName="ContentSite"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource TabHoverBrush}"
                                    TargetName="Border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placeholder content template for empty/future tabs -->
    <DataTemplate x:Key="PlaceholderTabContentTemplate">
        <Grid Margin="20">
            <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                               Converter={StaticResource PercentConverter}, ConverterParameter=0.6}"
                    MinHeight="200">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="🚧"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Coming Soon"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="This feature is under development."
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Generic tab content template for custom content -->
    <DataTemplate x:Key="GenericTabContentTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="5">
            <Grid Margin="10">
                <ContentPresenter Content="{Binding}"
                                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                             Converter={StaticResource PercentConverter}, ConverterParameter=0.95}"/>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
