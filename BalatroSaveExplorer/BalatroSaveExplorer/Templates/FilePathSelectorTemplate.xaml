<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Template for TextBox + Browse Button pattern -->
    <DataTemplate x:Key="FilePathSelectorTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                Converter={StaticResource PercentConverter}, ConverterParameter=0.75}"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
            <Button Grid.Column="1"
                    Content="Browse..."
                    MinWidth="80"
                    Height="25"/>
        </Grid>
    </DataTemplate>

    <!-- ControlTemplate for Grid-based file path selector -->
    <ControlTemplate x:Key="FilePathSelectorGrid" TargetType="Grid">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- TextBox will be placed in Grid.Column="0" by parent -->
            <!-- Button will be placed in Grid.Column="1" by parent -->
            <ContentPresenter Grid.Column="0"/>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
