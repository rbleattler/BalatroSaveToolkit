<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Template for Label + Value information display pattern -->
    <DataTemplate x:Key="InfoDisplayTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,10,0"/>
            <TextBox Grid.Column="1"
                     MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid},
                                Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Margin="0,0,0,5"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
