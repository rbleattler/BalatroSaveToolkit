<Window x:Class="BalatroSaveExplorer.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalatroSaveExplorer.Windows"
        mc:Ignorable="d"
        Title="Settings - Balatro Save Explorer" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings content -->
        <TabControl Grid.Row="0">
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Default Directories" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Label Content="Default JKR Directory:"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultJkrDirectoryTextBox" Grid.Column="0"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button x:Name="BrowseJkrDirectoryButton" Grid.Column="1"
                                            Content="Browse..." Width="80" Height="25"
                                            Click="BrowseJkrDirectoryButton_Click"/>
                                </Grid>

                                <Label Content="Default Lua Export Directory:"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultLuaExportDirectoryTextBox" Grid.Column="0"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button x:Name="BrowseLuaExportDirectoryButton" Grid.Column="1"
                                            Content="Browse..." Width="80" Height="25"
                                            Click="BrowseLuaExportDirectoryButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="File Operations" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="AutoSaveDecompressedFilesCheckBox"
                                          Content="Automatically save decompressed files to temp"
                                          Margin="0,0,0,5"/>
                                <CheckBox x:Name="ConfirmFileOverwritesCheckBox"
                                          Content="Confirm before overwriting existing files"
                                          Margin="0,0,0,5"/>
                                <CheckBox x:Name="EnableAutoBackupCheckBox"
                                          Content="Enable automatic backup of JKR files before processing"/>                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="File Watching" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EnableFileWatchingCheckBox"
                                          Content="Enable file watching for derived Balatro files"
                                          Margin="0,0,0,5"/>
                                <CheckBox x:Name="FlashTaskbarOnUpdateCheckBox"
                                          Content="Flash taskbar when watched files are updated"
                                          Margin="0,0,0,5"/>
                                <CheckBox x:Name="AutoRefreshOnFileChangeCheckBox"
                                          Content="Automatically refresh view when watched files change"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Backup Settings" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Label Content="Backup Directory:"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupDirectoryTextBox" Grid.Column="0"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button x:Name="BrowseBackupDirectoryButton" Grid.Column="1"
                                            Content="Browse..." Width="80" Height="25"
                                            Click="BrowseBackupDirectoryButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Balatro Integration" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Label Content="Balatro Save Root Directory:"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>                                    <TextBox x:Name="BalatroSaveRootTextBox" Grid.Column="0"
                                             VerticalAlignment="Center" Margin="0,0,5,0"
                                             TextChanged="BalatroSaveRootTextBox_TextChanged"/>
                                    <Button x:Name="BrowseBalatroSaveRootButton" Grid.Column="1"
                                            Content="Browse..." Width="80" Height="25"
                                            Click="BrowseBalatroSaveRootButton_Click"/>
                                </Grid>                                <Separator Margin="0,5,0,10"/>
                                <Label Content="Derived Paths (Read-only):" FontWeight="Bold"/>

                                <Label Content="Settings File:" Margin="0,5,0,0"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BalatroSettingsFilePathTextBox" Grid.Column="0" IsReadOnly="True"
                                             Background="LightGray" Margin="0,0,5,0"/>
                                    <Button x:Name="LoadBalatroSettingsButton" Grid.Column="1"
                                            Content="Load" Width="50" Height="25"
                                            Click="LoadBalatroSettingsButton_Click"/>
                                </Grid>

                                <Label Content="Current Profile:" Margin="0,5,0,0"/>
                                <TextBox x:Name="CurrentProfileNumberTextBox" IsReadOnly="True"
                                         Background="LightGray" Margin="0,0,0,5"/>

                                <Label Content="Profile Settings:" Margin="0,5,0,0"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CurrentProfileSettingsPathTextBox" Grid.Column="0" IsReadOnly="True"
                                             Background="LightGray" Margin="0,0,5,0"/>
                                    <Button x:Name="LoadProfileSettingsButton" Grid.Column="1"
                                            Content="Load" Width="50" Height="25"
                                            Click="LoadProfileSettingsButton_Click"/>
                                </Grid>

                                <Label Content="Profile Meta:" Margin="0,5,0,0"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CurrentProfileMetaPathTextBox" Grid.Column="0" IsReadOnly="True"
                                             Background="LightGray" Margin="0,0,5,0"/>
                                    <Button x:Name="LoadProfileMetaButton" Grid.Column="1"
                                            Content="Load" Width="50" Height="25"
                                            Click="LoadProfileMetaButton_Click"/>
                                </Grid>

                                <Label Content="Profile Save:" Margin="0,5,0,0"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CurrentProfileSavePathTextBox" Grid.Column="0" IsReadOnly="True"
                                             Background="LightGray" Margin="0,0,5,0"/>
                                    <Button x:Name="LoadProfileSaveButton" Grid.Column="1"
                                            Content="Load" Width="50" Height="25"
                                            Click="LoadProfileSaveButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Logging Tab -->
            <TabItem Header="Logging">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Log Display" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="ShowLogsOnStartupCheckBox"
                                          Content="Show logs panel on application startup"
                                          Margin="0,0,0,10"/>

                                <Label Content="Log Level:"/>
                                <ComboBox x:Name="LogLevelComboBox" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Debug"/>
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warning"/>
                                    <ComboBoxItem Content="Error"/>
                                </ComboBox>

                                <Label Content="Maximum Log Entries:"/>
                                <TextBox x:Name="MaxLogEntriesTextBox" Margin="0,0,0,10"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Application Information" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <TextBlock Text="Balatro Save Explorer" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="Version 1.0.0" Margin="0,0,0,5"/>
                                <TextBlock Text="A tool for viewing and editing Balatro save files (.jkr)"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="Settings File Location:" FontWeight="Bold" Margin="0,5,0,2"/>
                                <TextBox x:Name="SettingsFilePathTextBox" IsReadOnly="True"
                                         Background="LightGray" Margin="0,0,0,10"/>

                                <Button x:Name="OpenSettingsFolderButton" Content="Open Settings Folder"
                                        Width="150" HorizontalAlignment="Left"
                                        Click="OpenSettingsFolderButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ResetToDefaultsButton" Content="Reset to Defaults"
                    Width="120" Height="30" Margin="0,0,10,0"
                    Click="ResetToDefaultsButton_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30"
                    Margin="0,0,10,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
